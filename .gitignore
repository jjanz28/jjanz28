# Home directory repo defaults
# Keep this focused on noisy/generated/sensitive paths.

############################
# Linux user folders
############################
Desktop/
Documents/
Downloads/
Music/
Pictures/
Public/
Templates/
Videos/

############################
# Shell/editor history & temp files
############################
.bash_history
.zsh_history
.python_history
.lesshst
.wget-hsts
*.swp
*.swo
*~

############################
# Common caches / local state
############################
.cache/
.local/
.config/
.thumbnails/
.npm/
.pki/
.mozilla/
.var/

############################
# Language/tooling directories
############################
.cargo/
.rustup/
.gradle/
.m2/
.ivy2/
.bundle/
.venv/
venv/
node_modules/

############################
# Virtualization / containers
############################
.docker/

############################
# Snap and app-managed content
############################
snap/

############################
# Credentials and secrets
############################
.ssh/
.gnupg/
.aws/
.azure/
.kube/
.netrc
.npmrc
*.pem
*.key
*.p12
*.kdbx

############################
# Misc logs/artifacts
############################
*.log
